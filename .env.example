# Wallet (required for live/dry modes)

PRIVATE_KEY=your_0x_wallet_private_key



# Polymarket CLOB API (optional — derived from wallet if omitted)

POLYMARKET_API_KEY=

POLYMARKET_API_SECRET=

POLYMARKET_API_PASSPHRASE=



# Polygon mainnet

CHAIN_ID=137



# Bot mode override: live | dry | scan

BOT_MODE=dry



# Chainlink TWAP via Polymarket RTDS (Aug 7 2026 crypto settlement update)

CHAINLINK_TWAP_ENABLED=true

RTDS_URL=wss://ws-live-data.polymarket.com

CHAINLINK_TWAP_SYMBOLS=btc/usd,eth/usd,sol/usd

CHAINLINK_TWAP_MAX_AGE_MS=30000

RTDS_PING_INTERVAL_MS=5000



# Order execution slicing (optional, separate from Chainlink TWAP settlement)

EXECUTION_MODE=immediate

SLICE_COUNT=5

SLICE_DURATION_MS=60000

SLICE_MIN_SIZE=5

